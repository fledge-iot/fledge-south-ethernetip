#!/bin/sh
#
# Generate version.h from the VERSION file plus the current git checkout.
#
# Usage: mkversion <source-dir> [output-dir]
#
# Follows the Fledge plugin convention (see fledge-south-dnp3/mkversion): the
# VERSION file is the single source of truth for the plugin version, and that
# value is also what the packaging tooling puts in the .deb name.
#
# Two macros are emitted:
#
#   VERSION          the bare semantic version, exactly as in VERSION
#   PLUGIN_BUILD_ID  VERSION plus SemVer build metadata identifying the build:
#                      3.1.0+g75600be              clean checkout
#                      3.1.0+g75600be.dirty.20260806  uncommitted changes
#                      3.1.0+20260806              no git information available
#
# The file is only replaced when its contents change, so repeated builds of an
# unchanged checkout do not force a recompile.

set -e

SRCDIR="$1"
OUTDIR="${2:-.}"

if [ -z "$SRCDIR" ] || [ ! -f "$SRCDIR/VERSION" ]; then
	echo "mkversion: cannot read $SRCDIR/VERSION" >&2
	exit 1
fi

VERSION=$(head -1 "$SRCDIR/VERSION" | tr -d ' \t\r\n')
BUILD_DATE=$(date -u +%Y-%m-%d)
DATE_STAMP=$(date -u +%Y%m%d)

COMMIT=""
DIRTY=""
if command -v git >/dev/null 2>&1 && git -C "$SRCDIR" rev-parse --git-dir >/dev/null 2>&1; then
	COMMIT=$(git -C "$SRCDIR" rev-parse --short HEAD 2>/dev/null || echo "")
	if [ -n "$(git -C "$SRCDIR" status --porcelain 2>/dev/null)" ]; then
		DIRTY="yes"
	fi
fi

if [ -n "$COMMIT" ]; then
	BUILD_ID="${VERSION}+g${COMMIT}"
	[ -n "$DIRTY" ] && BUILD_ID="${BUILD_ID}.dirty.${DATE_STAMP}"
else
	COMMIT="unknown"
	BUILD_ID="${VERSION}+${DATE_STAMP}"
fi

TMPFILE="${OUTDIR}/version.h.new"
cat > "$TMPFILE" << END_OF_HEADER
/*
 * WARNING: This is an automatically generated file.
 *          Do not edit this file.
 *          To change the version edit the file VERSION.
 */

#define VERSION          "${VERSION}"
#define PLUGIN_BUILD_ID  "${BUILD_ID}"
#define PLUGIN_GIT_COMMIT "${COMMIT}"
#define PLUGIN_BUILD_DATE "${BUILD_DATE}"
END_OF_HEADER

if [ -f "${OUTDIR}/version.h" ] && cmp -s "$TMPFILE" "${OUTDIR}/version.h"; then
	rm -f "$TMPFILE"
else
	mv "$TMPFILE" "${OUTDIR}/version.h"
	echo "mkversion: ${BUILD_ID}"
fi
